# Intentionally unprotected: Bridge runs unattended and pass/GPG prompts would
# break startup. A passphrase only helps if it is kept outside the /data exposure
# boundary; in this single-container setup it would normally be readable by the
# same attacker who can read the GPG home.
%no-protection
%echo Generating a basic OpenPGP key
Key-Type: eddsa
Key-Curve: ed25519
Key-Usage: cert
Subkey-Type: ecdh
Subkey-Curve: cv25519
Subkey-Usage: encrypt
Name-Real: pass-key
Expire-Date: 0
%commit
%echo done
